{
	"name": "n8n-nodes-perspective",
	"version": "0.1.1",
	"description": "n8n community node for Perspective.co (Funnels) — REST API actions and webhook trigger",
	"license": "MIT",
	"homepage": "https://github.com/timdev-ger/n8n-perspective-node#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"perspective",
		"perspective-funnels",
		"funnel",
		"lead-generation",
		"crm"
	],
	"author": {
		"name": "Tim Querengässer",
		"email": "contact@timdev.info"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/timdev-ger/n8n-perspective-node.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PerspectiveApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Perspective/Perspective.node.js",
			"dist/nodes/PerspectiveTrigger/PerspectiveTrigger.node.js",
			"dist/nodes/PerspectivePollingTrigger/PerspectivePollingTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "10.4.0",
		"prettier": "3.8.3",
		"release-it": "20.0.1",
		"typescript": "6.0.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
